TWM_HOST=127.0.0.1
TWM_PORT=3131
TWM_DATA_DIR=./data
TWM_SESSION_BACKEND=zellij

# none, password, ssh, or comma-separated such as password,ssh
TWM_AUTH_MODE=password,ssh
TWM_ADMIN_USER=admin
TWM_ADMIN_PASSWORD=change-this-password
TWM_AUTHORIZED_KEYS_FILE=~/.ssh/authorized_keys

# Optional multi-user config. Existing TWM_ADMIN_USER keeps using TWM_DATA_DIR
# for backward compatibility; additional users use TWM_DATA_DIR/users/<name>/.
# TWM_USERS_JSON='[{"name":"alice","password":"alice-pass"},{"name":"bob","authorizedKeysFile":"~/.ssh/bob_authorized_keys"}]'
# TWM_USERS_FILE=./users.json

TWM_TMUX_BIN=tmux
TWM_ZELLIJ_BIN=zellij
TWM_COOKIE_SECURE=false

# History retention limits. Native sessions are still process-bound, but their
# recent transcript is retained for previews and reattach.
TWM_NATIVE_HISTORY_BYTES=50000000
TWM_NATIVE_SCREEN_SCROLLBACK=50000
TWM_TERMINAL_SNAPSHOT_VIEWPORT_LINES=120
TWM_TERMINAL_HISTORY_COLD_TAIL_LINES=500
TWM_TERMINAL_HISTORY_COLD_TAIL_BYTES=512000
TWM_TERMINAL_HISTORY_RANGE_LINES=800
TWM_TERMINAL_HISTORY_MAX_RANGE_LINES=5000
TWM_TERMINAL_HISTORY_RANGE_BYTES=1000000
TWM_PREVIEW_MAX_LINES=5000
TWM_TMUX_HISTORY_LIMIT=50000
TWM_ZELLIJ_SCROLLBACK=50000
